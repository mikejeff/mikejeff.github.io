{
  "typography": {
    "font-family": {
      "$type": "fontFamily",
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;"
      },
      "sans": {
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      }
    },
    "font-size": {
      "$type": "fontSize",
      "heading": {
        "$value": "2.5"
      },
      "body": {
        "$value": "1"
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "light": {
        "$type": "number",
        "$value": "300"
      },
      "regular": {
        "$type": "number",
        "$value": "400"
      },
      "semibold": {
        "$type": "number",
        "$value": "600"
      },
      "bold": {
        "$type": "number",
        "$value": "700"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.5
      },
      "large": {
        "$value": 1.8
      }
    },
    "composed": {
      "$type": "typography",
      "heading": {
        "$value": {
          "fontFamily": "{typography.font-family.sans}",
          "fontWeight": "{typography.font-weight.bold}",
          "fontSize": "{typography.font-size.heading}",
          "lineHeight": "{typography.line-height.tight}"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{typography.font-family.sans}",
          "fontWeight": "{typography.font-weight.regular}",
          "fontSize": "{typography.font-size.body}",
          "lineHeight": "{typography.line-height.normal}"
        }
      }
    }
  }
}
