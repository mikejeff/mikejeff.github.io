{
  "focus": {
    "$type": "focus",
    "ring": {
      "$type": "border",
      "style": {
        "$value": "solid"
      },
      "width": {
        "$type": "dimension",
        "$value": 0.1875
      },
      "color": {
        "$type": "color",
        "$value": "{colors.blue.200}"
      },
      "offset": {
        "$type": "dimension",
        "$value": 0.0625
      },
      "composite": {
        "$type": "border",
        "$value": {
          "style": "{focus.ring.style}",
          "width": "{focus.ring.width}",
          "color": "{focus.ring.color}"
        }
      }
    }
  }
}
