{
  "text": {
    "fonts": {
      "$type": "fontFamily",
      "serif": {
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      },
      "sans": {
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      }
    },
    "sizes": {
      "$type": "fontSize",
      "heading": {
        "$value": "2.5"
      },
      "body": {
        "$value": "1"
      }
    },
    "weights": {
      "$type": "fontWeight",
      "light": {
        "$value": "thin"
      },
      "regular": {
        "$type": "number",
        "$value": "400"
      },
      "bold": {
        "$type": "number",
        "$value": "700"
      }
    },
    "lineHeights": {
      "$type": "number",
      "normal": {
        "$value": 1.5
      },
      "tight": {
        "$value": 1.2
      },
      "large": {
        "$value": 1.8
      }
    },
    "typography": {
      "$type": "typography",
      "heading": {
        "$value": {
          "fontFamily": "{text.fonts.sans}",
          "fontWeight": "{text.weights.bold}",
          "fontSize": "{text.sizes.heading}",
          "lineHeight": "{text.lineHeights.tight}"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{text.fonts.serif}",
          "fontWeight": "{text.weights.regular}",
          "fontSize": "{text.sizes.body}",
          "lineHeight": "{text.lineHeights.normal}"
        }
      }
    }
  }
}
